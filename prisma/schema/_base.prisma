generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ToolResult {
  SUCCESS
  FAILURE
}

enum Plan {
  FREE
  PRO
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String
  name         String?
  plan         Plan          @default(FREE)
  subscription Subscription?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model ToolEvent {
  id          String     @id @default(cuid())
  tool        String
  result      ToolResult
  errorCode   String?
  inputBytes  Int?
  outputBytes Int?
  durationMs  Int?
  createdAt   DateTime   @default(now())

  @@index([tool, createdAt])
  @@index([createdAt])
}

enum SubscriptionStatus {
  PENDING
  AUTHORIZED
  PAUSED
  CANCELLED
}

// Mirrors a Mercado Pago "preapproval" (suscripción recurrente). Un usuario
// tiene a lo sumo una Subscription; el historial de altas/bajas vive en
// Mercado Pago, acá solo guardamos el estado vigente.
model Subscription {
  id               String             @id @default(cuid())
  userId           String             @unique
  user             User               @relation(fields: [userId], references: [id])
  mpPreapprovalId  String             @unique
  status           SubscriptionStatus @default(PENDING)
  // Fin del período ya pagado. Con status AUTHORIZED, el usuario es PRO
  // hasta esta fecha aunque el próximo cobro todavía no se haya procesado.
  currentPeriodEnd DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([status])
}

// Registro de notificaciones de webhook ya procesadas, para no aplicar la
// misma notificación de Mercado Pago dos veces (MP puede reintentar envíos).
model WebhookEvent {
  id          String    @id @default(cuid())
  provider    String
  externalId  String
  type        String
  payload     Json
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([provider, externalId])
}
