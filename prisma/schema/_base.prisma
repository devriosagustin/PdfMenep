generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ToolResult {
  SUCCESS
  FAILURE
}

enum Plan {
  FREE
  PRO
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  plan         Plan     @default(FREE)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ToolEvent {
  id          String     @id @default(cuid())
  tool        String
  result      ToolResult
  errorCode   String?
  inputBytes  Int?
  outputBytes Int?
  durationMs  Int?
  createdAt   DateTime   @default(now())

  @@index([tool, createdAt])
  @@index([createdAt])
}
