# ============================================================================
# PdfMenep — example environment variables
# Copy this file to `.env` (or `.env.local`) and fill in your real values.
#   cp .env.example .env
# The project uses `@t3-oss/env-nextjs`; env is validated at startup and the
# build will fail if required variables are missing (see src/lib/env.ts).
#   - Set SKIP_ENV_VALIDATION=1 only for envless builds (lint/CI previews).
# ============================================================================

# --- Required: server ---

# PostgreSQL connection string used by Prisma (data-plane / database).
# Provider is hardcoded to postgresql in prisma/schema/_base.prisma.
# dev example: postgresql://user:password@localhost:5432/pdfmenep
DATABASE_URL="postgresql://user:password@localhost:5432/pdfmenep"

# Secret used by NextAuth v5 to sign session JWTs.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
AUTH_SECRET="cambia-esto-por-un-secreto-aleatorio"

# Mercado Pago — suscripción PRO recurrente (Checkout Pro / preapproval).
# Access token de PRODUCCIÓN o de TEST según el ambiente — nunca lo compartas
# ni lo commitees. Se obtiene en https://www.mercadopago.com.ar/developers/panel/app
MERCADOPAGO_ACCESS_TOKEN="APP_USR-xxxxxxxx-xxxxxx-xxxxxxxxxxxxxxxxxxxxxxxx-xxxxxxxxx"

# Secreto de firma del webhook (panel de Mercado Pago > tu app > Webhooks).
# Se usa para validar el header `x-signature` de cada notificación entrante.
MERCADOPAGO_WEBHOOK_SECRET="cambia-esto-por-el-secreto-que-te-da-mercado-pago"

# Precio mensual del plan PRO, en pesos argentinos, sin centavos (ej: 4999).
MERCADOPAGO_PRO_PRICE_ARS="4999"

# --- Optional: server ---
# NODE_ENV=development            # defaults to "development"

# --- Client (NEXT_PUBLIC_*) ---
# Defaults are fine for local dev, override only as needed.

# Public base URL of the app (used for absolute links, sitemap, og images).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: set ONLY if your API runs on a different origin than the app.
# Leave empty (unset) for same-origin `/api` calls.
# NEXT_PUBLIC_API_URL="https://api.pdfmenep.com"

# --- Build only (not for production runtime) ---
# SKIP_ENV_VALIDATION=1
